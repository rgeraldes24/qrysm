load("@qrysm//tools/go:def.bzl", "go_library", "go_test")

go_library(
    name = "remote-web3signer",
    srcs = [
        "capabilities.go",
        "keyfile.go",
        "keymanager.go",
        "log.go",
        "metrics.go",
    ],
    importpath = "github.com/theQRL/qrysm/validator/keymanager/remote-web3signer",
    visibility = [
        "//cmd/validator:__subpackages__",
        "//validator:__subpackages__",
    ],
    deps = [
        "//async",
        "//async/event",
        "//config/fieldparams",
        "//config/params",
        "//consensus-types/primitives",
        "//crypto/ml_dsa_87",
        "//encoding/bytesutil",
        "//io/file",
        "//proto/qrl/service",
        "//proto/qrysm/v1alpha1/validator-client",
        "//validator/accounts/petnames",
        "//validator/keymanager",
        "//validator/keymanager/remote-web3signer/internal",
        "//validator/keymanager/remote-web3signer/v1:remote-web3signer",
        "@com_github_fsnotify_fsnotify//:fsnotify",
        "@com_github_logrusorgru_aurora//:aurora",
        "@com_github_pkg_errors//:errors",
        "@com_github_prometheus_client_golang//prometheus",
        "@com_github_prometheus_client_golang//prometheus/promauto",
        "@com_github_sirupsen_logrus//:logrus",
        "@com_github_theqrl_go_qrl//common/hexutil",
    ],
)

# The remote signer's golden vectors, shared by the tests of this package and
# its subpackages.
filegroup(
    name = "vectors_testdata",
    testonly = True,
    srcs = glob(["testdata/vectors/**"]),
    visibility = ["//validator/keymanager/remote-web3signer:__subpackages__"],
)

go_test(
    name = "remote-web3signer_test",
    srcs = [
        "fake_signer_test.go",
        "keyfile_test.go",
        "keymanager_test.go",
    ],
    data = [":vectors_testdata"],
    embed = [":remote-web3signer"],
    deps = [
        "//config/fieldparams",
        "//config/params",
        "//crypto/ml_dsa_87",
        "//proto/qrl/service",
        "//proto/qrysm/v1alpha1/validator-client",
        "//runtime/interop",
        "//testing/assert",
        "//testing/require",
        "//validator/keymanager",
        "//validator/keymanager/remote-web3signer/internal",
        "//validator/keymanager/remote-web3signer/v1/mock",
        "@com_github_sirupsen_logrus//:logrus",
        "@com_github_sirupsen_logrus//hooks/test",
        "@com_github_theqrl_go_qrl//common/hexutil",
    ],
)
